# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Nothing here has a default: a missing value stops the process at startup
# rather than starting it half-wired and filing nothing.

# --- Jira ---
# https://id.atlassian.com/manage-profile/security/api-tokens (scoped token, write:jira-work)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Scoped API tokens do NOT work against https://<site>.atlassian.net — they return
# 401 AUTHENTICATED_FAILED. They must go through Atlassian's gateway, which needs
# the cloud id:
#   curl -s "$JIRA_BASE_URL/_edge/tenant_info"   (public, no auth)
# JIRA_BASE_URL stays, for building human-clickable links in the Slack message.
JIRA_CLOUD_ID=
JIRA_API_BASE=https://api.atlassian.com/ex/jira

# --- Slack ---
# https://api.slack.com/apps -> OAuth & Permissions -> chat:write + chat:write.public
# Bot token starts xoxb-. Channel id starts C, user id starts U.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_DM_USER_ID=

# --- Model ---
# Any OpenAI-compatible chat-completions endpoint. Model ids are retired often —
# never hardcode one. List what your key can reach with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $AI_API_KEY"
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# Azure AI Foundry uses an api-key header instead of Bearer, names the model in
# the URL, and needs an api-version. The analyser reads these rather than
# branching on a provider name, so switching provider is config, not code.
# Ollama works too: point AI_ENDPOINT at http://localhost:11434/v1/chat/completions.
AI_AUTH_HEADER=Authorization
AI_API_VERSION=

# --- This service ---
# The one secret the Flutter app carries, passed to it via --dart-define.
#   openssl rand -hex 32
INGEST_APP_TOKEN=

# Render injects PORT itself. Only set this to override the local default (8787).
PORT=

# Per-commit Flutter debug info. See symbols/README.md. The Docker image bakes
# ./symbols in and sets this to /symbols; override it for a local `dart run`.
SYMBOLS_DIR=

# Survives a restart so the same broken button files one ticket, not twenty.
# Free-tier hosting has no persistent disk, so this resets on every spin-down.
DEDUPE_PATH=

# Optional. A checkout of the code the crashing build came from: the analyser
# quotes the lines around the crash site so the ticket shows real before/after
# code instead of prose. Left empty — or pointing anywhere that does not hold
# the file a frame names — the ticket simply keeps prose. Only files under this
# directory are ever read. Point it at a repository root, never a parent: a wide
# root like /Users/you puts the Flutter SDK inside it, and the ticket then
# quotes framework code instead of yours.
SOURCE_DIR=
